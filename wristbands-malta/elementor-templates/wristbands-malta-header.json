          "settings": {
            "html": "<style>\n.wbm-header{\n  --navy:#1c244b;\n  --navy-deep:#10152e;\n  --accent:#477ff7;\n  --ink:#1c244b;\n  --line:#e7e9ef;\n  position:sticky; top:0; z-index:1000;\n  background:#fff;\n  border-bottom:1px solid var(--line);\n  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;\n  overflow-x:clip;\n}\n\n.wbm-header-inner{\n  max-width:1240px;\n  margin:0 auto;\n  padding:0.9rem 1.5rem;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:1.5rem;\n}\n\n/* ---- Logo ---- */\n.wbm-logo{\n  display:inline-flex;\n  align-items:center;\n  text-decoration:none;\n  color:var(--ink);\n  flex-shrink:0;\n}\n.wbm-logo-img{\n  display:block !important;\n  height:clamp(34px, 4.6vw, 46px) !important;\n  width:auto !important;\n  max-width:none !important;\n}\n\n/* ---- Nav ---- */\n.wbm-nav-toggle{ display:none; }\n\n.wbm-nav{\n  display:flex;\n  align-items:center;\n  gap:2.1rem;\n  margin:0;\n  padding:0;\n  list-style:none;\n}\n.wbm-nav a{\n  color:var(--ink);\n  text-decoration:none;\n  font-weight:600;\n  font-size:0.98rem;\n  position:relative;\n  padding:0.3rem 0;\n}\n.wbm-nav a::after{\n  content:\"\";\n  position:absolute;\n  left:0; bottom:0;\n  width:0; height:2px;\n  background:var(--accent);\n  transition:width .2s ease;\n}\n.wbm-nav a:hover::after{ width:100%; }\n.wbm-nav a:hover{ color:var(--accent); }\n\n.wbm-right{\n  display:flex;\n  align-items:center;\n  gap:2.1rem;\n}\n\n/* ---- CTA button: dark-blue gradient fades in on hover ---- */\n.wbm-cta{\n  position:relative;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  overflow:hidden;\n  background:var(--navy);\n  color:#fff;\n  text-decoration:none;\n  font-weight:700;\n  font-size:0.92rem;\n  letter-spacing:0.03em;\n  padding:0.75rem 1.7rem;\n  border-radius:999px;\n  white-space:nowrap;\n  isolation:isolate;\n  transition:transform .2s ease, box-shadow .2s ease;\n}\n.wbm-cta::before{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  z-index:-1;\n  background:linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 60%, #000814 100%);\n  opacity:0;\n  transition:opacity .35s ease;\n}\n.wbm-cta:hover::before{ opacity:1; }\n.wbm-cta:hover{\n  transform:translateY(-1px);\n  box-shadow:0 8px 20px rgba(10,18,38,0.35), 0 0 0 3px rgba(71,127,247,0.25);\n}\n\n/* ---- Mobile ---- */\n.wbm-burger{\n  display:none;\n  width:26px; height:20px;\n  position:relative;\n  cursor:pointer;\n  flex-shrink:0;\n}\n.wbm-burger span{\n  position:absolute; left:0; right:0; height:2px;\n  background:var(--ink);\n  border-radius:2px;\n  transition:transform .25s ease, opacity .25s ease, top .25s ease;\n}\n.wbm-burger span:nth-child(1){ top:0; }\n.wbm-burger span:nth-child(2){ top:9px; }\n.wbm-burger span:nth-child(3){ top:18px; }\n\n@media (max-width:860px){\n  .wbm-nav{\n    position:fixed;\n    top:64px;\n    left:0; right:0;\n    flex-direction:column;\n    align-items:flex-start;\n    gap:0;\n    background:#fff;\n    border-bottom:1px solid var(--line);\n    max-height:0;\n    overflow:hidden;\n    transition:max-height .3s ease;\n  }\n  .wbm-nav a{\n    width:100%;\n    padding:1rem 1.5rem;\n    border-bottom:1px solid var(--line);\n  }\n  .wbm-nav a::after{ display:none; }\n  .wbm-right{ gap:0.8rem; }\n  .wbm-burger{ display:block; }\n  .wbm-nav-toggle:checked ~ .wbm-header-inner .wbm-nav{ max-height:70vh; overflow-y:auto; }\n  .wbm-nav-toggle:checked ~ .wbm-header-inner .wbm-burger span:nth-child(1){ top:9px; transform:rotate(45deg); }\n  .wbm-nav-toggle:checked ~ .wbm-header-inner .wbm-burger span:nth-child(2){ opacity:0; }\n  .wbm-nav-toggle:checked ~ .wbm-header-inner .wbm-burger span:nth-child(3){ top:9px; transform:rotate(-45deg); }\n  .wbm-cta{ padding:0.6rem 1.15rem; font-size:0.82rem; }\n  .wbm-header-inner{ padding:0.8rem 1rem; gap:0.6rem; }\n}\n\n@media (max-width:420px){\n  .wbm-header-inner{ gap:0.4rem; }\n  .wbm-right{ gap:0.5rem; }\n  .wbm-logo-img{ height:clamp(28px, 8vw, 36px) !important; }\n  .wbm-cta{ padding:0.55rem 0.85rem; font-size:0.72rem; letter-spacing:0.01em; }\n  .wbm-burger{ width:22px; }\n}\n\n/*\n  NOTE on \"top:64px\" above: the JS version measured the header's real\n  height and set it dynamically. This static value assumes the header is\n  roughly 64px tall on mobile (matches the current fixed-size logo/CTA).\n  If the mobile dropdown nav ends up with a visible gap above or overlaps\n  the header slightly once you see it live, tell me the actual height and\n  I'll adjust this number.\n*/\n</style>\n\n<header class=\"wbm-header\" id=\"wbm-header\">\n  <input type=\"checkbox\" id=\"wbm-nav-toggle\" class=\"wbm-nav-toggle\">\n  <div class=\"wbm-header-inner\">\n\n    <a href=\"/\" class=\"wbm-logo\" aria-label=\"Wristbands Malta \u2014 home\">\n      <img\n        src=\"https://darkslategrey-louse-379748.hostingersite.com/wp-content/uploads/2026/06/WM-logo-1-scaled.png\"\n        alt=\"Wristbands Malta\"\n        class=\"wbm-logo-img\"\n        loading=\"eager\"\n        decoding=\"async\">\n    </a>\n\n    <nav class=\"wbm-nav\" aria-label=\"Primary\">\n      <a href=\"/\">Home</a>\n      <a href=\"/about-us/\">About us</a>\n      <a href=\"/shop/\">Shop</a>\n      <a href=\"/contact/\">Contact</a>\n    </nav>\n\n    <div class=\"wbm-right\">\n      <a href=\"/order-now/\" class=\"wbm-cta\">ORDER NOW</a>\n      <label class=\"wbm-burger\" for=\"wbm-nav-toggle\" aria-label=\"Toggle menu\">\n        <span></span><span></span><span></span>\n      </label>\n    </div>\n\n  </div>\n</header>\n"
          },
          "elements": [],
          "widgetType": "html"
        }
      ],
      "isInner": false
    }
  ],
